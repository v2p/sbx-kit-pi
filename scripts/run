#!/usr/bin/env bash
set -euo pipefail

update_existing=0
import_codex_auth=0
additional_kits=()
import_file=
notification_file=
notification_listener_pid=

notification_listener() {
  set +e
  local queue_file=$1

  exec 3< "$queue_file" || return

  process_notifications() {
    local title body
    while IFS=$'\t' read -r title body <&3; do
      notify-send --app-name=Pi -- \
        "${title:-Pi finished}" "${body:-Ready for input}" >/dev/null 2>&1 || true
    done
  }

  running=1
  trap 'running=0' INT TERM HUP

  while (( running )); do
    process_notifications
    sleep 0.2 &
    wait $! 2>/dev/null || true
  done

  # Drain events written just before the attached Pi process exited.
  process_notifications
  exec 3<&-
}

cleanup_host_state() {
  if [[ -n $import_file ]]; then
    rm -f -- "$import_file"
  fi
  if [[ -n $notification_listener_pid ]]; then
    kill "$notification_listener_pid" 2>/dev/null || true
    wait "$notification_listener_pid" 2>/dev/null || true
  fi
  if [[ -n $notification_file ]]; then
    rm -f -- "$notification_file"
  fi
}
trap cleanup_host_state EXIT

while (( $# )); do
  case $1 in
    --attach)
      printf '%s\n' '--attach is no longer supported; existing sandboxes are attached automatically' >&2
      exit 2
      ;;
    --update)
      update_existing=1
      shift
      ;;
    --import-codex-auth)
      import_codex_auth=1
      shift
      ;;
    --kit)
      if (( $# < 2 )); then
        printf 'Missing kit reference after --kit\n' >&2
        exit 2
      fi
      additional_kits+=("$2")
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

launcher=$(readlink -f "${BASH_SOURCE[0]}")
kit_dir=$(cd "$(dirname "$launcher")/.." && pwd -P)
workspace=$(pwd -P)
project_name=$(basename "$workspace")
workspace_hash=$(printf '%s' "$workspace" | git hash-object --stdin)
sandbox_name="pi-openai-codex-${project_name}-${workspace_hash:0:12}"
session_dir="$HOME/pi-sessions-backup/${project_name}-${workspace_hash:0:12}"
skills_dir="$session_dir/skills"

mkdir -p "$skills_dir"

pi_args=(
  --session-dir "$session_dir"
  "$@"
)

notifications=${SBX_PI_NOTIFICATIONS:-auto}
case ${notifications,,} in
  auto)
    notifications=auto
    ;;
  1|true|on)
    notifications=on
    ;;
  0|false|off)
    notifications=off
    ;;
  *)
    printf 'Invalid SBX_PI_NOTIFICATIONS value: %s (expected auto, on, or off)\n' "$notifications" >&2
    exit 2
    ;;
esac

if [[ $notifications != off ]]; then
  if command -v notify-send >/dev/null 2>&1; then
    notification_file="$session_dir/.notifications.queue"
    rm -f -- "$notification_file"
    (umask 077; : > "$notification_file")
    notification_listener "$notification_file" &
    notification_listener_pid=$!
  elif [[ $notifications == on ]]; then
    printf '%s\n' 'SBX_PI_NOTIFICATIONS is enabled, but notify-send is not installed on the host' >&2
    exit 2
  fi
fi

existing_sandboxes=$(sbx ls -q)
sandbox_exists=0
if grep -Fxq -- "$sandbox_name" <<< "$existing_sandboxes"; then
  sandbox_exists=1
fi

if (( sandbox_exists && ${#additional_kits[@]} && ! update_existing )); then
  printf 'Sandbox %s already exists; use --update to change its kits\n' "$sandbox_name" >&2
  exit 2
fi

if (( sandbox_exists && import_codex_auth && ! update_existing )); then
  printf 'Sandbox %s already exists; use --update to import Codex credentials into a recreated sandbox\n' "$sandbox_name" >&2
  exit 2
fi

if (( sandbox_exists && ! update_existing )); then
  sbx run --name "$sandbox_name" -- "${pi_args[@]}"
  exit
fi

import_dir=
if (( import_codex_auth )); then
  codex_auth_file="${CODEX_HOME:-$HOME/.codex}/auth.json"
  if [[ ! -f $codex_auth_file || ! -r $codex_auth_file ]]; then
    printf 'Codex authentication file is not readable: %s\n' "$codex_auth_file" >&2
    exit 2
  fi

  state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
  import_dir="$state_home/sbx-kit-pi/import/$sandbox_name"
  import_file="$import_dir/codex-auth.json"
  install -d -m 0700 "$import_dir"
  install -m 0600 "$codex_auth_file" "$import_file"

  pi_args+=(--sbx-pi-import-codex-auth "$import_file")
fi

if (( update_existing )); then
  if (( sandbox_exists )); then
    printf 'Recreating sandbox %s with the current kit image and selected mixins\n' "$sandbox_name"
    sbx rm -f "$sandbox_name"
  else
    printf 'Sandbox %s does not exist; creating it with the current kit image and selected mixins\n' "$sandbox_name"
  fi
fi

kit_args=(--kit "$kit_dir")
for kit in "${additional_kits[@]}"; do
  kit_args+=(--kit "$kit")
done

volume_args=("$session_dir")
if [[ -n $import_dir ]]; then
  volume_args+=("$import_dir")
fi

if (( import_codex_auth )); then
  sbx run \
    --name "$sandbox_name" \
    "${kit_args[@]}" \
    pi-openai-codex \
    "$workspace" \
    "${volume_args[@]}" \
    -- "${pi_args[@]}"
  exit
fi

sbx run \
  --name "$sandbox_name" \
  "${kit_args[@]}" \
  pi-openai-codex \
  "$workspace" \
  "${volume_args[@]}" \
  -- "${pi_args[@]}"
