#!/usr/bin/env bash
set -euo pipefail

attach_existing=0
update_existing=0
case ${1:-} in
  --attach)
    attach_existing=1
    shift
    ;;
  --update)
    update_existing=1
    shift
    ;;
esac

launcher=$(readlink -f "${BASH_SOURCE[0]}")
kit_dir=$(cd "$(dirname "$launcher")/.." && pwd -P)
workspace=$(pwd -P)
project_name=$(basename "$workspace")
workspace_hash=$(printf '%s' "$workspace" | git hash-object --stdin)
sandbox_name="pi-openai-codex-${project_name}-${workspace_hash:0:12}"
session_dir="$HOME/pi-sessions-backup/${project_name}-${workspace_hash:0:12}"
skills_dir="$session_dir/skills"

mkdir -p "$skills_dir"

pi_args=(
  --session-dir "$session_dir"
  "$@"
)

if (( attach_existing )); then
  exec sbx run --name "$sandbox_name" -- "${pi_args[@]}"
fi

if (( update_existing )); then
  existing_sandboxes=$(sbx ls -q)
  if grep -Fxq -- "$sandbox_name" <<< "$existing_sandboxes"; then
    printf 'Recreating sandbox %s with the current kit image\n' "$sandbox_name"
    sbx rm -f "$sandbox_name"
  else
    printf 'Sandbox %s does not exist; creating it with the current kit image\n' "$sandbox_name"
  fi
fi

exec sbx run \
  --name "$sandbox_name" \
  --kit "$kit_dir" \
  pi-openai-codex \
  "$workspace" \
  "$session_dir" \
  -- "${pi_args[@]}"
