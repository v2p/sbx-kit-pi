#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'Usage: sbx-pi [OPTIONS] [--] [PI_ARGS...]' \
    '       sbx-pi status [OPTIONS]' \
    '       sbx-pi plan [OPTIONS]' \
    '       sbx-pi config show [OPTIONS]' \
    '       sbx-pi config alias NAME KIT [--replace]' \
    '       sbx-pi completion zsh' \
    '' \
    'Create sbxenv.yaml if needed, then create or attach to the sandbox.' \
    '' \
    'Options:' \
    '  --recreate           Replace the sandbox; discard sandbox-local changes.' \
    '                       Host-mounted sessions and workspace files survive.' \
    '  --import-codex-auth  Copy the host Codex login when creating a sandbox.' \
    '  --env PATH           Load native environment YAML (repeatable, in order).' \
    '  --env-arg NAME=VALUE  Pass a declared argument to Docker (repeatable).' \
    '  --env-args-file PATH Load declared arguments from a file (repeatable).' \
    '  --allow-host HOST    Replace supplemental allowed hosts (repeatable).' \
    '  --kit KIT            Replace the saved YAML mixins (repeat for multiple).' \
    '  --no-kits            Save an empty YAML mixin list.' \
    '  --config PATH        Select Pi TOML and its sibling sbxenv.yaml.' \
    '  -h, --help           Show this help without starting Docker Sandbox.' \
    '' \
    'status, plan, and config show are read-only; they do not accept kit edits.' \
    'Launcher options must precede Pi arguments; use -- to pass Pi --help.' \
    '' \
    'Examples:' \
    '  sbx-pi' \
    '  sbx-pi --continue' \
    '  sbx-pi --recreate --kit @node'
}

if [[ ${1:-} == -h || ${1:-} == --help ]] ||
   [[ ${1:-} == config && ( ${2:-} == -h || ${2:-} == --help ) ]]; then
  usage
  exit 0
fi

launcher=$(readlink -f "${BASH_SOURCE[0]}")
kit_dir=$(cd "$(dirname "$launcher")/.." && pwd -P)
source "$kit_dir/scripts/node-environment"

# Completion must bypass workspace discovery and all launch-time side effects.
if [[ ${1:-} == completion || ${1:-} == _complete ]]; then
  command=$1
  shift
  if [[ $command == completion ]]; then
    exec node "$kit_dir/scripts/completion-generate.mts" "${0##*/}" "$@"
  fi
  exec node "$kit_dir/scripts/launcher-completion.mts" "$@"
fi

recreate_existing=0
import_codex_auth=0
config_args=()
native_args=()
explicit_hosts=0
config_file=
protocol_file=
config_command=resolve
import_file=
rpc_listener_pid=
rpc_ready_dir=

cleanup_host_state() {
  if [[ -n $config_file ]]; then
    rm -f -- "$config_file"
  fi
  if [[ -n $protocol_file ]]; then
    rm -f -- "$protocol_file"
  fi
  if [[ -n $import_file ]]; then
    rm -f -- "$import_file"
  fi
  if [[ -n $rpc_listener_pid ]]; then
    kill "$rpc_listener_pid" 2>/dev/null || true
    wait "$rpc_listener_pid" 2>/dev/null || true
  fi
  if [[ -n $rpc_ready_dir ]]; then
    rm -rf -- "$rpc_ready_dir"
  fi
}
trap cleanup_host_state EXIT

if [[ ${1:-} == config && ${2:-} == show ]]; then
  config_command=show
  shift 2
elif [[ ${1:-} == config && ${2:-} == alias ]]; then
  config_command=alias
  shift 2
elif [[ ${1:-} == status || ${1:-} == plan ]]; then
  config_command=$1
  shift
elif [[ ${1:-} == config ]]; then
  printf '%s\n' 'Usage: sbx-pi config show [OPTIONS] | config alias NAME KIT [--replace]' >&2
  exit 2
fi

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  usage
  exit 0
fi

while [[ $config_command != alias ]] && (( $# )); do
  case $1 in
    -h|--help)
      usage
      exit 0
      ;;
    --recreate)
      recreate_existing=1
      shift
      ;;
    --import-codex-auth)
      import_codex_auth=1
      shift
      ;;
    --kit)
      if (( $# < 2 )); then
        printf 'Missing kit reference after --kit\n' >&2
        exit 2
      fi
      config_args+=(--kit "$2")
      shift 2
      ;;
    --no-kits)
      config_args+=(--no-kits)
      shift
      ;;
    --allow-host)
      if (( $# < 2 )); then
        printf 'Missing host after --allow-host\n' >&2
        exit 2
      fi
      explicit_hosts=1
      config_args+=(--allow-host "$2")
      shift 2
      ;;
    --env|--env-arg|--env-args-file)
      if (( $# < 2 )); then
        printf 'Missing value after %s\n' "$1" >&2
        exit 2
      fi
      config_args+=("$1" "$2")
      if [[ $1 != --env ]]; then
        value=$2
        if [[ $1 == --env-args-file ]]; then
          value=$(realpath "$value")
        fi
        native_args+=("$1" "$value")
      fi
      shift 2
      ;;
    --config)
      if (( $# < 2 )); then
        printf 'Missing path after --config\n' >&2
        exit 2
      fi
      config_args+=(--config "$2")
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if [[ $config_command == alias ]]; then
  exec node "$kit_dir/scripts/launcher-config.mts" alias "$@"
fi
if [[ $config_command != resolve && $config_command != plan ]]; then
  if (( $# || recreate_existing || import_codex_auth )); then
    printf 'Unexpected arguments for %s\n' "$config_command" >&2
    exit 2
  fi
  exec node "$kit_dir/scripts/launcher-config.mts" "$config_command" "${config_args[@]}"
fi

config_file=$(mktemp)
resolution_command=launch
if [[ $config_command == plan ]]; then
  resolution_command=resolve
fi
node "$kit_dir/scripts/launcher-config.mts" "$resolution_command" "${config_args[@]}" > "$config_file"
protocol_file=$(mktemp)
node "$kit_dir/scripts/launcher-config.mts" fields "$config_file" > "$protocol_file"
mapfile -d '' -t resolved < "$protocol_file"
workspace=${resolved[0]}
sandbox_name=${resolved[1]}
host_rpc_allow=${resolved[2]}
kits_changed=${resolved[3]}
project_name=$(basename "$workspace")
workspace_hash=$(printf '%s' "$workspace" | git hash-object --stdin)
session_dir="$HOME/pi-sessions-backup/${project_name}-${workspace_hash:0:12}"
cd "$workspace"
skills_dir="$session_dir/skills"

if [[ $config_command == plan ]]; then
  if (( $# || recreate_existing || import_codex_auth )); then
    printf '%s\n' 'plan requires sbxenv.yaml and accepts only configuration options' >&2
    exit 2
  fi
  node "$kit_dir/scripts/launcher-config.mts" environment "$config_file" "$session_dir" > "$protocol_file"
  mapfile -d '' -t environment_paths < "$protocol_file"
  sbx env plan "${environment_paths[@]}" "${native_args[@]}"
  exit
fi

mkdir -p "$skills_dir"

pi_args=(
  --session-dir "$session_dir"
  "$@"
)

if [[ $host_rpc_allow != off ]]; then
  rpc_ready_dir=$(mktemp -d)
  rpc_log="${XDG_STATE_HOME:-$HOME/.local/state}/sbx-pi/host-rpc/${workspace_hash}.jsonl"
  node "$kit_dir/scripts/host-rpc-listener.mts" \
    "$session_dir" "$rpc_log" "$sandbox_name" "$workspace" \
    "$rpc_ready_dir/ready" "$config_file" &
  rpc_listener_pid=$!
  for (( attempt=0; attempt<100; attempt++ )); do
    if [[ -f $rpc_ready_dir/ready ]]; then break; fi
    if ! kill -0 "$rpc_listener_pid" 2>/dev/null; then
      wait "$rpc_listener_pid" || true
      printf '%s\n' 'Host RPC listener failed to start (another launcher or stale queue may exist)' >&2
      exit 2
    fi
    sleep 0.05
  done
  if [[ ! -f $rpc_ready_dir/ready ]]; then
    printf '%s\n' 'Host RPC listener did not become ready' >&2
    exit 2
  fi
fi

existing_sandboxes=$(sbx ls -q)
sandbox_exists=0
if [[ -n $sandbox_name ]] && grep -Fxq -- "$sandbox_name" <<< "$existing_sandboxes"; then
  sandbox_exists=1
fi

if (( kits_changed && ! recreate_existing )) && { (( sandbox_exists )) || [[ -z $sandbox_name ]]; }; then
  printf '%s\n' 'Kit selection saved. Use sbx-pi --recreate to apply it to an existing sandbox; sandbox-local changes will be deleted.' >&2
  exit 2
fi

if (( explicit_hosts && ! recreate_existing )) && [[ -z $sandbox_name ]]; then
  printf '%s\n' 'Explicit allowed-host overrides with parameterized names require --recreate; otherwise use project TOML' >&2
  exit 2
fi

if (( sandbox_exists && explicit_hosts && ! recreate_existing )); then
  printf 'Sandbox %s already exists; use --recreate to change its allowed hosts\n' "$sandbox_name" >&2
  exit 2
fi

if (( sandbox_exists && import_codex_auth && ! recreate_existing )); then
  printf 'Sandbox %s already exists; use --recreate to import Codex credentials into a recreated sandbox\n' "$sandbox_name" >&2
  exit 2
fi

import_dir=
if (( import_codex_auth )) && [[ -z $sandbox_name ]]; then
  printf '%s\n' 'Codex import requires a literal environment name so existing-sandbox checks are safe' >&2
  exit 2
fi
if (( import_codex_auth )); then
  codex_auth_file="${CODEX_HOME:-$HOME/.codex}/auth.json"
  if [[ ! -f $codex_auth_file || ! -r $codex_auth_file ]]; then
    printf 'Codex authentication file is not readable: %s\n' "$codex_auth_file" >&2
    exit 2
  fi

  state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
  # Native names are validated by Docker, so never use them as host paths.
  import_name="native-$(printf '%s' "$sandbox_name" | git hash-object --stdin)"
  import_dir="$state_home/sbx-kit-pi/import/$import_name"
  import_file="$import_dir/codex-auth.json"
  install -d -m 0700 "$import_dir"
  install -m 0600 "$codex_auth_file" "$import_file"

  pi_args+=(--sbx-pi-import-codex-auth "$import_file")
fi

# Native YAML owns sandbox resources and approvals. This adapter only adds
# the Pi kit and its host persistence; do not translate YAML into sbx flags.
node "$kit_dir/scripts/launcher-config.mts" environment "$config_file" "$session_dir" "$import_dir" > "$protocol_file"
mapfile -d '' -t environment_paths < "$protocol_file"
if (( recreate_existing )) && { (( sandbox_exists )) || [[ -z $sandbox_name ]]; }; then
  sbx env rm "${environment_paths[@]}" "${native_args[@]}" --force
  node "$kit_dir/scripts/launcher-config.mts" forget "$config_file"
fi
if (( sandbox_exists && ! recreate_existing )); then
  node "$kit_dir/scripts/launcher-config.mts" compare "$config_file"
fi
sbx env run "${environment_paths[@]}" "${native_args[@]}" --detach
if [[ -n $sandbox_name ]] && (( ! sandbox_exists || recreate_existing )); then
  node "$kit_dir/scripts/launcher-config.mts" record "$config_file"
fi
# env run has no agent-argument passthrough. env exec keeps Docker's environment
# resolution while allowing Pi arguments. The image and native exec both use
# this wrapper, which owns the provider, model, and bundled extension defaults.
terminal_args=(-i)
if [[ -t 0 && -t 1 ]]; then terminal_args+=(-t); fi
sbx env exec "${terminal_args[@]}" "${environment_paths[@]}" "${native_args[@]}" -- /opt/sbx-kit-pi/scripts/container-entrypoint "${pi_args[@]}"
