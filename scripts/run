#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'Usage: sbx-pi [OPTIONS] [--] [PI_ARGS...]' \
    '       sbx-pi init [--kit KIT ... | --no-kits]' \
    '       sbx-pi status [OPTIONS]' \
    '       sbx-pi plan [OPTIONS]' \
    '       sbx-pi config show [OPTIONS]' \
    '       sbx-pi config alias NAME KIT [--replace]' \
    '       sbx-pi completion zsh' \
    '' \
    'Create a sandbox for this workspace, or attach if it already exists.' \
    '' \
    'Options:' \
    '  --recreate           Replace the sandbox; discard sandbox-local changes.' \
    '                       Host-mounted sessions and workspace files survive.' \
    '  --import-codex-auth  Copy the host Codex login when creating a sandbox.' \
    '  --env PATH           Load native environment YAML (repeatable, in order).' \
    '  --env-arg NAME=VALUE  Pass a declared argument to Docker (repeatable).' \
    '  --env-args-file PATH Load declared arguments from a file (repeatable).' \
    '  --allow-host HOST    Replace supplemental allowed hosts (repeatable).' \
    '  --kit KIT            Select mixins for init or legacy TOML-only projects.' \
    '  --no-kits            Clear the selected mixins.' \
    '  --config PATH        Select Pi TOML and its sibling sbxenv.yaml.' \
    '  --no-config          Ignore project discovery; use the current directory.' \
    '  -h, --help           Show this help without starting Docker Sandbox.' \
    '' \
    'status and config show accept only kit and configuration options.' \
    'Launcher options must precede Pi arguments; use -- to pass Pi --help.' \
    '' \
    'Examples:' \
    '  sbx-pi' \
    '  sbx-pi --continue' \
    '  sbx-pi --recreate --kit @node'
}

if [[ ${1:-} == -h || ${1:-} == --help ]] ||
   [[ ${1:-} == config && ( ${2:-} == -h || ${2:-} == --help ) ]]; then
  usage
  exit 0
fi

# Completion must bypass workspace discovery and all launch-time side effects.
if [[ ${1:-} == completion || ${1:-} == _complete ]]; then
  launcher=$(readlink -f "${BASH_SOURCE[0]}")
  kit_dir=$(cd "$(dirname "$launcher")/.." && pwd -P)
  command=$1
  shift
  if [[ $command == completion ]]; then
    exec node "$kit_dir/scripts/completion-generate.mjs" "${0##*/}" "$@"
  fi
  exec node "$kit_dir/scripts/launcher-completion.mjs" "$@"
fi

recreate_existing=0
import_codex_auth=0
additional_kits=()
config_args=()
native_args=()
explicit_kits=0
explicit_hosts=0
config_file=
protocol_file=
config_command=resolve
import_file=
notification_file=
notification_listener_pid=

notification_listener() {
  set +e
  local queue_file=$1

  exec 3< "$queue_file" || return

  process_notifications() {
    local title body
    while IFS=$'\t' read -r title body <&3; do
      notify-send --app-name=Pi -- \
        "${title:-Pi finished}" "${body:-Ready for input}" >/dev/null 2>&1 || true
    done
  }

  running=1
  trap 'running=0' INT TERM HUP

  while (( running )); do
    process_notifications
    sleep 0.2 &
    wait $! 2>/dev/null || true
  done

  # Drain events written just before the attached Pi process exited.
  process_notifications
  exec 3<&-
}

cleanup_host_state() {
  if [[ -n $config_file ]]; then
    rm -f -- "$config_file"
  fi
  if [[ -n $protocol_file ]]; then
    rm -f -- "$protocol_file"
  fi
  if [[ -n $import_file ]]; then
    rm -f -- "$import_file"
  fi
  if [[ -n $notification_listener_pid ]]; then
    kill "$notification_listener_pid" 2>/dev/null || true
    wait "$notification_listener_pid" 2>/dev/null || true
  fi
  if [[ -n $notification_file ]]; then
    rm -f -- "$notification_file"
  fi
}
trap cleanup_host_state EXIT

if [[ ${1:-} == config && ${2:-} == show ]]; then
  config_command=show
  shift 2
elif [[ ${1:-} == config && ${2:-} == alias ]]; then
  config_command=alias
  shift 2
elif [[ ${1:-} == init ]]; then
  config_command=init
  shift
elif [[ ${1:-} == status || ${1:-} == plan ]]; then
  config_command=$1
  shift
elif [[ ${1:-} == config ]]; then
  printf '%s\n' 'Usage: sbx-pi config show [OPTIONS] | config alias NAME KIT [--replace]' >&2
  exit 2
fi

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  usage
  exit 0
fi

while [[ $config_command != alias ]] && (( $# )); do
  case $1 in
    -h|--help)
      usage
      exit 0
      ;;
    --recreate)
      recreate_existing=1
      shift
      ;;
    --import-codex-auth)
      import_codex_auth=1
      shift
      ;;
    --kit)
      if (( $# < 2 )); then
        printf 'Missing kit reference after --kit\n' >&2
        exit 2
      fi
      explicit_kits=1
      config_args+=(--kit "$2")
      shift 2
      ;;
    --no-kits)
      explicit_kits=1
      config_args+=(--no-kits)
      shift
      ;;
    --allow-host)
      if (( $# < 2 )); then
        printf 'Missing host after --allow-host\n' >&2
        exit 2
      fi
      explicit_hosts=1
      config_args+=(--allow-host "$2")
      shift 2
      ;;
    --env|--env-arg|--env-args-file)
      if (( $# < 2 )); then
        printf 'Missing value after %s\n' "$1" >&2
        exit 2
      fi
      config_args+=("$1" "$2")
      if [[ $1 != --env ]]; then
        value=$2
        if [[ $1 == --env-args-file ]]; then
          value=$(realpath "$value")
        fi
        native_args+=("$1" "$value")
      fi
      shift 2
      ;;
    --config)
      if (( $# < 2 )); then
        printf 'Missing path after --config\n' >&2
        exit 2
      fi
      config_args+=(--config "$2")
      shift 2
      ;;
    --no-config)
      config_args+=(--no-config)
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

launcher=$(readlink -f "${BASH_SOURCE[0]}")
kit_dir=$(cd "$(dirname "$launcher")/.." && pwd -P)
if [[ $config_command == alias ]]; then
  exec node "$kit_dir/scripts/launcher-config.mjs" alias "$@"
fi
if [[ $config_command != resolve && $config_command != plan ]]; then
  if (( $# || recreate_existing || import_codex_auth )); then
    printf 'Unexpected arguments for %s\n' "$config_command" >&2
    exit 2
  fi
  exec node "$kit_dir/scripts/launcher-config.mjs" "$config_command" "${config_args[@]}"
fi

config_file=$(mktemp)
node "$kit_dir/scripts/launcher-config.mjs" resolve "${config_args[@]}" > "$config_file"
protocol_file=$(mktemp)
node "$kit_dir/scripts/launcher-config.mjs" fields "$config_file" > "$protocol_file"
mapfile -d '' -t resolved < "$protocol_file"
workspace=${resolved[0]}
notifications=${resolved[1]}
sandbox_name=${resolved[2]}
project_file=${resolved[3]}
environment_mode=${resolved[4]}
additional_kits=("${resolved[@]:5}")
project_name=$(basename "$workspace")
workspace_hash=$(printf '%s' "$workspace" | git hash-object --stdin)
session_dir="$HOME/pi-sessions-backup/${project_name}-${workspace_hash:0:12}"
cd "$workspace"
skills_dir="$session_dir/skills"

if [[ $config_command == plan ]]; then
  if (( $# || recreate_existing || import_codex_auth )) || [[ $environment_mode != native ]]; then
    printf '%s\n' 'plan requires sbxenv.yaml and accepts only configuration options' >&2
    exit 2
  fi
  node "$kit_dir/scripts/launcher-config.mjs" environment "$config_file" "$session_dir" > "$protocol_file"
  mapfile -d '' -t environment_paths < "$protocol_file"
  sbx env plan "${environment_paths[@]}" "${native_args[@]}"
  exit
fi

mkdir -p "$skills_dir"

pi_args=(
  --session-dir "$session_dir"
  "$@"
)

if [[ $notifications != off ]]; then
  if command -v notify-send >/dev/null 2>&1; then
    notification_file="$session_dir/.notifications.queue"
    rm -f -- "$notification_file"
    (umask 077; : > "$notification_file")
    notification_listener "$notification_file" &
    notification_listener_pid=$!
  elif [[ $notifications == on ]]; then
    printf '%s\n' 'SBX_PI_NOTIFICATIONS is enabled, but notify-send is not installed on the host' >&2
    exit 2
  fi
fi

existing_sandboxes=$(sbx ls -q)
sandbox_exists=0
if [[ -n $sandbox_name ]] && grep -Fxq -- "$sandbox_name" <<< "$existing_sandboxes"; then
  sandbox_exists=1
fi

if (( sandbox_exists && explicit_kits && ! recreate_existing )); then
  printf 'Sandbox %s already exists; use --recreate to change its kits\n' "$sandbox_name" >&2
  exit 2
fi

if (( explicit_hosts && ! recreate_existing )) && [[ $environment_mode == native && -z $sandbox_name ]]; then
  printf '%s\n' 'Explicit allowed-host overrides with parameterized names require --recreate; otherwise use project TOML' >&2
  exit 2
fi

if (( sandbox_exists && explicit_hosts && ! recreate_existing )); then
  printf 'Sandbox %s already exists; use --recreate to change its allowed hosts\n' "$sandbox_name" >&2
  exit 2
fi

if (( sandbox_exists && import_codex_auth && ! recreate_existing )); then
  printf 'Sandbox %s already exists; use --recreate to import Codex credentials into a recreated sandbox\n' "$sandbox_name" >&2
  exit 2
fi

if (( sandbox_exists && ! recreate_existing )) && [[ $environment_mode == legacy ]]; then
  node "$kit_dir/scripts/launcher-config.mjs" compare "$config_file"
  sbx run --name "$sandbox_name" -- "${pi_args[@]}"
  exit
fi

if (( ! sandbox_exists )) && [[ -z $project_file && $environment_mode == legacy ]]; then
  printf '%s\n' 'Run sbx-pi init to persist this project’s sandbox setup.' >&2
fi

import_dir=
if (( import_codex_auth )) && [[ $environment_mode == native && -z $sandbox_name ]]; then
  printf '%s\n' 'Codex import requires a literal environment name so existing-sandbox checks are safe' >&2
  exit 2
fi
if (( import_codex_auth )); then
  codex_auth_file="${CODEX_HOME:-$HOME/.codex}/auth.json"
  if [[ ! -f $codex_auth_file || ! -r $codex_auth_file ]]; then
    printf 'Codex authentication file is not readable: %s\n' "$codex_auth_file" >&2
    exit 2
  fi

  state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
  import_name=$sandbox_name
  if [[ $environment_mode == native ]]; then
    # Native names are validated by Docker, so never use them as host paths.
    import_name="native-$(printf '%s' "$sandbox_name" | git hash-object --stdin)"
  fi
  import_dir="$state_home/sbx-kit-pi/import/$import_name"
  import_file="$import_dir/codex-auth.json"
  install -d -m 0700 "$import_dir"
  install -m 0600 "$codex_auth_file" "$import_file"

  pi_args+=(--sbx-pi-import-codex-auth "$import_file")
fi

if [[ $environment_mode == native ]]; then
  # Native YAML owns sandbox resources and approvals. This adapter only adds
  # the Pi kit and its host persistence; do not translate YAML into sbx flags.
  node "$kit_dir/scripts/launcher-config.mjs" environment "$config_file" "$session_dir" "$import_dir" > "$protocol_file"
  mapfile -d '' -t environment_paths < "$protocol_file"
  if (( recreate_existing )) && { (( sandbox_exists )) || [[ -z $sandbox_name ]]; }; then
    sbx env rm "${environment_paths[@]}" "${native_args[@]}" --force
    node "$kit_dir/scripts/launcher-config.mjs" forget "$config_file"
  fi
  if (( sandbox_exists && ! recreate_existing )); then
    node "$kit_dir/scripts/launcher-config.mjs" compare "$config_file"
  fi
  sbx env run "${environment_paths[@]}" "${native_args[@]}" --detached
  if [[ -n $sandbox_name ]] && (( ! sandbox_exists || recreate_existing )); then
    node "$kit_dir/scripts/launcher-config.mjs" record "$config_file"
  fi
  # env run has no agent-argument passthrough. env exec keeps Docker's environment
  # resolution while allowing Pi arguments, using the kit's actual entrypoint.
  node "$kit_dir/scripts/launcher-config.mjs" entrypoint > "$protocol_file"
  mapfile -d '' -t entrypoint < "$protocol_file"
  terminal_args=(-i)
  if [[ -t 0 && -t 1 ]]; then terminal_args+=(-t); fi
  sbx env exec "${terminal_args[@]}" "${environment_paths[@]}" "${native_args[@]}" -- "${entrypoint[@]}" "${pi_args[@]}"
  exit
fi

if [[ -n $project_file ]]; then
  printf '%s\n' 'Legacy TOML kits are deprecated; move sandbox settings to sbxenv.yaml (sbx-pi init).' >&2
fi

if (( recreate_existing )); then
  if (( sandbox_exists )); then
    printf 'Recreating sandbox %s with the current kit image and selected mixins\n' "$sandbox_name"
    sbx rm -f "$sandbox_name"
    node "$kit_dir/scripts/launcher-config.mjs" forget "$config_file"
  else
    printf 'Sandbox %s does not exist; creating it with the current kit image and selected mixins\n' "$sandbox_name"
  fi
fi

printf 'Creating sandbox %s with mixins:\n' "$sandbox_name"
if (( ${#additional_kits[@]} )); then
  printf '  %s\n' "${additional_kits[@]}"
else
  printf '  (none)\n'
fi

kit_args=(--kit "$kit_dir")
for kit in "${additional_kits[@]}"; do
  kit_args+=(--kit "$kit")
done

node "$kit_dir/scripts/launcher-config.mjs" network-kit "$config_file" > "$protocol_file"
network_kit=$(< "$protocol_file")
if [[ -n $network_kit ]]; then kit_args+=(--kit "$network_kit"); fi

volume_args=("$session_dir")
if [[ -n $import_dir ]]; then
  volume_args+=("$import_dir")
fi

sbx run \
  --name "$sandbox_name" \
  "${kit_args[@]}" \
  pi-openai-codex \
  "$workspace" \
  "${volume_args[@]}" \
  -- "${pi_args[@]}"
node "$kit_dir/scripts/launcher-config.mjs" record "$config_file"
