#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
source "$root/scripts/node-environment"

printf '%s\n' '==> Installing test dependencies'
npm ci --ignore-scripts --no-audit --no-fund

printf '%s\n' '==> Auditing development and runtime dependencies'
npm run audit

printf '%s\n' '==> Checking code formatting'
npm run format:check

printf '%s\n' '==> Linting JavaScript and TypeScript'
npm run lint

printf '%s\n' '==> Type-checking TypeScript'
npm run typecheck

printf '%s\n' '==> Running static tests'
npm test

if command -v docker >/dev/null 2>&1; then
  printf '%s\n' '==> Building and smoke-testing the local Docker Sandbox image'
  make image
  printf '%s\n' '==> Building v3 workload and example mixin descriptors'
  docker build --file spec.yaml .
  docker build --file examples/mixins/project-bootstrap/spec.yaml examples/mixins/project-bootstrap
else
  printf '%s\n' '==> SKIP: Docker is unavailable; run "make image" on a Docker host' >&2
fi

if command -v sbx >/dev/null 2>&1; then
  printf '%s\n' '==> Running Docker Sandbox kit validation'
  sbx kit validate --offline .
  sbx kit validate --offline examples/mixins/project-bootstrap
else
  printf '%s\n' '==> SKIP: sbx is unavailable; run "sbx kit validate --offline ." on a Docker Sandbox host' >&2
fi
