{
  "name": "sbx-kit-pi",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Validation tests for the Pi OpenAI Codex Docker Sandbox kit",
  "scripts": {
    "audit": "npm audit --audit-level=moderate && npm --prefix runtime audit --audit-level=moderate",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,mts,mjs,js}\" \"*.json\" \"runtime/*.json\"",
    "format:check": "prettier --check \"**/*.{ts,mts,mjs,js}\" \"*.json\" \"runtime/*.json\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typebox": "1.3.30",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "undici": "8.12.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "smol-toml": "1.9.0",
    "yaml": "2.9.0"
  }
}
