{
  "name": "sbx-kit-pi",
  "version": "0.3.2",
  "private": true,
  "description": "Validation tests for the Pi OpenAI Codex Docker Sandbox kit",
  "scripts": {
    "audit": "npm audit --audit-level=moderate",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,mjs,js}\" \"*.json\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,js}\" \"*.json\"",
    "test": "node --test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typebox": "1.3.30",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "smol-toml": "1.9.0"
  }
}
