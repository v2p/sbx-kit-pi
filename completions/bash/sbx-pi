# Bash completion for sbx-pi (Bash 4+).
_sbx_pi_complete() {
  local current=${COMP_WORDS[COMP_CWORD]:-} kind candidate
  local -a response
  COMPREPLY=()
  mapfile -t response < <("${COMP_WORDS[0]}" _complete "${COMP_WORDS[@]:1:COMP_CWORD}" 2>/dev/null)
  kind=${response[0]:-words}
  if [[ $kind == files ]]; then
    mapfile -t COMPREPLY < <(compgen -f -- "$current")
    compopt -o filenames 2>/dev/null || true
  else
    for candidate in "${response[@]:1}"; do
      COMPREPLY+=("$candidate")
    done
  fi
}
